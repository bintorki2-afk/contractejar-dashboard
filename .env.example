# =============================================================================
# «عقد إيجار» (contractejar.com) Admin Dashboard — environment template
# Copy to `.env.local` (local dev) or set these in your host's env (Vercel/cPanel).
# Every browser-exposed value must be prefixed NEXT_PUBLIC_ ; treat them as public.
# =============================================================================

# --- Backend API -------------------------------------------------------------
# Production Laravel API base, INCLUDING the trailing /api segment.
# Used by the server-side axios client (SSR). In the browser the app calls the
# same-origin /api/* path, which Next.js rewrites to API_PROXY_TARGET (below).
NEXT_PUBLIC_BASE_URL=https://aqdi-new-backend-main-production.up.railway.app/api

# Server-only rewrite target for /api/* (see next.config.mjs -> rewrites()).
# This is what the BROWSER effectively talks to in production. NOT NEXT_PUBLIC_.
# Leave unset to fall back to the default (صقر ١ backend on Railway, see next.config.mjs).
# Always the صقر ١ backend (Railway) — never another project's server.
API_PROXY_TARGET=https://aqdi-new-backend-main-production.up.railway.app/api

# Optional: origin used to build absolute links to backend files (/storage/..., signed
# deed/attachment URLs) when the API returns relative paths. Defaults to the ORIGIN of
# API_PROXY_TARGET (see next.config.mjs -> env.BACKEND_ASSET_ORIGIN, src/lib/asset-url.js).
# Set it only if files are served from a different host (e.g. a CDN). Origin only, no path.
# BACKEND_ASSET_ORIGIN=https://aqdi-new-backend-main-production.up.railway.app

# --- Firebase Cloud Messaging (Web Push notifications) -----------------------
# From Firebase console -> Project settings -> General -> "Your apps" (Web app).
# Leave every Firebase value blank to run the dashboard with push disabled
# (isFirebaseConfigured() gates the feature; a placeholder service worker is
# generated when these are missing — no crash).
NEXT_PUBLIC_FIREBASE_API_KEY=            # Web API Key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=        # e.g. your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=         # Firebase project id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=     # e.g. your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=# Cloud Messaging sender id (numeric)
NEXT_PUBLIC_FIREBASE_APP_ID=             # Web app id (1:...:web:...)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=     # optional, Analytics (G-XXXX)
# Cloud Messaging -> Web configuration -> "Web Push certificates" key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=          # public VAPID key for web push

# --- Firebase Realtime Database (SEO crawl live progress) --------------------
# Realtime Database instance URL; enables the live SEO-crawl progress feature.
# Leave blank to disable it (isRealtimeDbConfigured() gates it).
NEXT_PUBLIC_FIREBASE_DATABASE_URL=       # e.g. https://your-project-default-rtdb.firebaseio.com
